# Neon PostgreSQL connection strings (copy from Neon dashboard)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# Admin bootstrap account (used by seed/create-admin script)
ADMIN_NAME="Site Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeThisToALongUniquePassword!"

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
SESSION_SECRET="replace-with-at-least-32-random-characters"
UPLOAD_MAX_IMAGE_MB="8"
UPLOAD_MAX_VIDEO_MB="50"

# Optional external media storage. Recommended for production uploads:
# Cloudinary or S3-compatible storage can be added; starter uses URL-based media records.
