generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Post {
  id        String    @id @default(cuid())
  mediaUrl  String
  mediaType String
  altText   String    @default("Barber portfolio work")
  caption   String?
  pinned    Boolean   @default(false)
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  comments  Comment[]
  likes     Like[]
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  deviceId  String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, deviceId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  name      String
  text      String
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(cuid())
  name      String
  rating    Int
  feedback  String
  status    String   @default("PENDING")
  deviceId  String
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model SiteContent {
  id              String   @id @default("main")
  siteTitle       String   @default("Anish Shah")
  name            String   @default("Anish Shah")
  tagline         String   @default("Premium barber services")
  bio             String   @default("Sharp cuts. Clean looks. Better you.")
  profilePhoto    String?
  heroImage       String?
  yearsExperience Int      @default(6)
  services        Json
  hours           Json
  social          Json
  seoTitle        String   @default("Anish Shah | Premium Barber")
  seoDescription  String   @default("Book a premium haircut, beard trim, or shave.")
  accentColor     String   @default("#e7b94f")
  updatedAt       DateTime @updatedAt
}

model Location {
  id        String   @id @default("main")
  address   String   @default("12 Barber Lane, Kathmandu, Nepal")
  phone     String   @default("+977 9800000000")
  mapUrl    String?
  latitude  Float?
  longitude Float?
  hours     Json
  updatedAt DateTime @updatedAt
}

model BookingLink {
  id          String   @id @default(cuid())
  title       String
  url         String
  icon        String   @default("calendar")
  description String   @default("")
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}
